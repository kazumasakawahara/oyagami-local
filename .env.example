# Neo4j (~/Dev-Work/neo4j-agno-agent/docker-compose.yml で起動)
# Neo4j 認証は ~/.config/nest/neo4j.env を参照（NEO4J_URI / NEO4J_USERNAME / NEO4J_PASSWORD はここに書かない。~/.zshrc が自動で読み込む）

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# モデル設定
COORDINATOR_MODEL=gemma4:12b
INTAKE_MODEL=deepseek-r1:70b
VALIDATOR_MODEL=gemma4:12b
ANALYST_MODEL=llama4:latest
CYPHER_MODEL=qwen3-coder:30b
EMBEDDING_MODEL=nomic-embed-text

# サーバー
BACKEND_PORT=8000
FRONTEND_PORT=3000
